# ---- Server -------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to true when the API runs behind a reverse proxy (needed for correct client IPs / rate limiting).
TRUST_PROXY=false

# ---- Database (SQL Server) -----------------------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MoldTracking
DB_USER=your_sql_login
DB_PASSWORD=your_sql_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ---- Authentication ------------------------------------------------------
# Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Lifetime of the short-lived access token (jsonwebtoken format: 15m, 1h ...)
ACCESS_TOKEN_TTL=15m
# Lifetime of the rotating refresh token (stored as an httpOnly cookie), in days
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when the API is served over HTTPS so the refresh cookie gets the Secure flag
COOKIE_SECURE=false

# ---- Rate limiting --------------------------------------------------------
# Failed + successful login attempts allowed per IP per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
# General API limit per IP per minute
API_RATE_LIMIT_MAX=600

# ---- Demo data (npm run seed) --------------------------------------------
# Password given to the demo admin / engineer / viewer accounts. Local development only.
SEED_PASSWORD=Demo-2026
