{
  "name": "mold-tracking-system",
  "version": "2.0.0",
  "description": "Injection mould lifecycle tracker: REST API (Express + SQL Server) with a React dashboard and an in-browser demo mode",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "seed": "node scripts/seed.js",
    "seed:generate": "node scripts/generate-seed-data.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:frontend": "npm --prefix frontend test",
    "install:frontend": "npm --prefix frontend install",
    "dev:frontend": "npm --prefix frontend run dev",
    "sync:demo-schemas": "node scripts/sync-demo-schemas.js",
    "build:demo": "npm --prefix frontend run build:demo"
  },
  "keywords": [
    "mold-tracking",
    "manufacturing",
    "express",
    "mssql",
    "react",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mssql": "^12.7.13",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.1"
  }
}
